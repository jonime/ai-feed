NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only; never expose these through NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Supabase CLI OAuth configuration: put these in the ignored root .env file.
# The CLI does not load .env.local. Never use NEXT_PUBLIC_ for the secret.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
